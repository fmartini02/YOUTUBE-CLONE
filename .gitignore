# ── Segreti e dati personali — mai online ──────────────────────────────────
data/cookies.txt
data/oauth_token.json
data/oauth_setup.json
data/subscriptions.json
data/subscriptions_feed_cache.json
data/channel_avatars.json
data/history.json
data/prefs.json
.env
.env.local
.env.*.local

# Chiavi di firma Android — la chiave privata dell'app e la sua password.
# Perderle significa non poter più aggiornare l'APK installato sul telefono
# senza disinstallarlo: tienine una copia fuori dal repo.
*.keystore
*.jks
frontend/android/keystore/keystore.properties

# ── Dipendenze — rigenerabili con npm install ──────────────────────────────
node_modules/

# ── Build Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Android / Capacitor — rigenerabili con npx cap sync + gradlew ──────────
frontend/android/**/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/*.apk
*.apk
dist-android/

# ── Build Electron — rigenerabile con npm run build ─────────────────────────
dist-electron/

# ── Claude Code — configurazione locale e worktree ─────────────────────────
# I worktree sotto .claude/worktrees/ sono checkout completi del repo stesso:
# versionarli significherebbe infilare il repo dentro sé stesso.
# Eccezione: .claude/agents/ sono i subagent del progetto, .claude/commands/ gli
# slash command, .claude/settings.json gli hook (rebuild dist/ + norm_check) —
# conoscenza condivisa come CLAUDE.md, quindi versionata. Resta fuori
# .claude/settings.local.json, per le scelte personali di chi clona (permessi,
# override). La negazione richiede `.claude/*` al posto di `.claude/`: git non
# può re-includere un file se la cartella padre è esclusa.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/settings.json

# ── Varie ────────────────────────────────────────────────────────────────────
.ytdlp_last_update
